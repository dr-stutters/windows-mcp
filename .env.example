# Windows Server (WinRM / PowerShell remoting) connection settings.
# Copy to .env and fill in. Never commit .env.
WINRM_HOST=192.0.2.50
WINRM_USERNAME=Administrator
WINRM_PASSWORD=changeme
# Auth: ntlm (simplest from Linux, username/password), kerberos, credssp, or basic.
WINRM_AUTH=ntlm
# Use HTTPS (port 5986) if a WinRM listener cert is configured; else HTTP (5985).
WINRM_SSL=false
WINRM_PORT=5985
# Verify the WinRM TLS cert (labs usually use self-signed -> false).
WINRM_CERT_VALIDATION=false
# Per-operation timeout in seconds (AD/CA installs can be slow).
WINRM_TIMEOUT=120

# =====================================================================
# Lab build parameters (optional). NOT read by the MCP server's WinRM
# connection - a convenient place to keep the lab's details for the
# windows-engineer agent to build the domain / DNS / DHCP / CA against.
# =====================================================================

# --- Active Directory domain (Install-ADDSForest) ---
AD_DOMAIN_NAME=lab.local
AD_NETBIOS_NAME=LAB
# Directory Services Restore Mode (safe-mode) password for the DC.
AD_DSRM_PASSWORD=changeme
# NOTE: after promotion the box is a DC (no local accounts) - update
# WINRM_USERNAME above to the domain admin, e.g. LAB\Administrator
# (same password the local Administrator had).

# --- AD Certificate Services (the CA that signs ISE's certs) ---
CA_COMMON_NAME=lab-Root-CA

# --- A test AD user (for ISE external-identity / auth testing) ---
AD_TEST_USER=iseuser1
AD_TEST_USER_PASSWORD=changeme

# --- DHCP scope (optional) ---
DHCP_SCOPE_NAME=LAB-Clients
DHCP_START_RANGE=10.0.0.100
DHCP_END_RANGE=10.0.0.200
DHCP_SUBNET_MASK=255.255.255.0
